{
  "name": "@nova-ui-library/angular",
  "version": "0.0.1",
  "description": "Angular components for Nova UI",
  "license": "MIT",
  "author": "shdhrubo",
  "repository": {
    "type": "git",
    "url": "https://github.com/shdhrubo/nova-ui.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/shdhrubo/nova-ui#readme",
  "bugs": {
    "url": "https://github.com/shdhrubo/nova-ui/issues"
  },
  "keywords": [
    "nova-ui",
    "angular",
    "angular-components",
    "ui-library",
    "design-system",
    "accessible",
    "standalone"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ngc -p tsconfig.json",
    "test": "echo 'Unit tests deferred per user instruction'",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@angular/common": ">=17.0.0",
    "@angular/forms": ">=17.0.0"
  },
  "dependencies": {
    "@nova-ui-library/core": "*",
    "@nova-ui-library/styles": "*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
