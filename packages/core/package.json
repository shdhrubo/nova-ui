{
  "name": "@nova-ui-library/core",
  "version": "0.0.3",
  "description": "Framework-independent types, behavior, and accessibility utilities for Nova UI",
  "license": "MIT",
  "author": "shdhrubo",
  "repository": {
    "type": "git",
    "url": "https://github.com/shdhrubo/nova-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shdhrubo/nova-ui#readme",
  "bugs": {
    "url": "https://github.com/shdhrubo/nova-ui/issues"
  },
  "keywords": [
    "nova-ui",
    "design-system",
    "accessibility",
    "a11y",
    "ui-core",
    "headless"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-ui-library/tokens": "*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
