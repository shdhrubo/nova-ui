{
  "name": "@nova-ui/core",
  "version": "0.0.1",
  "description": "Framework-independent types, behavior, and accessibility utilities for Nova UI",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-ui/tokens": "*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
